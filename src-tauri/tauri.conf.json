{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spawner",
  "version": "0.1.0",
  "identifier": "dev.spawner.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spawner",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQTY4OUYwNDc5NjFGMEIKUldRTEg1Wkg4SW1tNnZYc1hQSkM4K05LUkEvK1M3czhlRm1tWU9IZWQ3azg4eEk0L0MzZTdLYzUK",
      "endpoints": ["https://github.com/uFleck/spawner/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
